  "components": {
    "schemas": {
      "CommentCreate": {
        "properties": {
          "user_id": { "type": "integer", "title": "User Id", "examples": [2] },
          "text": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Text",
            "examples": ["Awesome post!"]
          }
        },
        "type": "object",
        "required": ["user_id", "text"],
        "title": "CommentCreate"
      },
      "CommentOut": {
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "post_id": { "type": "integer", "title": "Post Id" },
          "user_id": { "type": "integer", "title": "User Id" },
          "text": { "type": "string", "title": "Text" },
          "created_at": { "type": "string", "format": "date-time", "title": "Created At" }
        },
        "type": "object",
        "required": ["id", "post_id", "user_id", "text", "created_at"],
        "title": "CommentOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": { "$ref": "#/components/schemas/ValidationError" },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LikeCreate": {
        "properties": { "user_id": { "type": "integer", "title": "User Id", "examples": [2] } },
        "type": "object",
        "required": ["user_id"],
        "title": "LikeCreate"
      },
      "LikeOut": {
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "post_id": { "type": "integer", "title": "Post Id" },
          "user_id": { "type": "integer", "title": "User Id" },
          "created_at": { "type": "string", "format": "date-time", "title": "Created At" }
        },
        "type": "object",
        "required": ["id", "post_id", "user_id", "created_at"],
        "title": "LikeOut"
      },
      "PostCreate": {
        "properties": {
          "user_id": { "type": "integer", "title": "User Id", "examples": [1] },
          "content": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Content",
            "examples": ["Hello from my first API call!"]
          }
        },
        "type": "object",
        "required": ["user_id", "content"],
        "title": "PostCreate"
      },
      "PostOut": {
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "user_id": { "type": "integer", "title": "User Id" },
          "content": { "type": "string", "title": "Content" },
          "created_at": { "type": "string", "format": "date-time", "title": "Created At" },
          "likes_count": { "type": "integer", "title": "Likes Count", "default": 0 },
          "comments_count": { "type": "integer", "title": "Comments Count", "default": 0 }
        },
        "type": "object",
        "required": ["id", "user_id", "content", "created_at"],
        "title": "PostOut"
      },
      "PostUpdate": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Content",
            "examples": ["Updated post content!"]
          }
        },
        "type": "object",
        "required": ["content"],
        "title": "PostUpdate"
      },
      "UserCreate": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 50,
            "minLength": 2,
            "title": "Username",
            "examples": ["sara_pm"]
          },
          "display_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Display Name",
            "examples": ["Sara"]
          },
          "bio": {
            "type": "string",
            "maxLength": 250,
            "title": "Bio",
            "default": "",
            "examples": ["Product Manager learning APIs"]
          }
        },
        "type": "object",
        "required": ["username", "display_name"],
        "title": "UserCreate"
      },
      "UserOut": {
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "username": { "type": "string", "title": "Username" },
          "display_name": { "type": "string", "title": "Display Name" },
          "bio": { "type": "string", "title": "Bio" },
          "created_at": { "type": "string", "format": "date-time", "title": "Created At" }
        },
        "type": "object",
        "required": ["id", "username", "display_name", "bio", "created_at"],
        "title": "UserOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
            "type": "array",
            "title": "Location"
          },
          "msg": { "type": "string", "title": "Message" },
          "type": { "type": "string", "title": "Error Type" },
          "input": { "title": "Input" },
          "ctx": { "type": "object", "title": "Context" }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
}
